	column order_estimated_delivery_date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 39168cd0-1927-4778-98d1-bbec48a21dc5
		summarizeBy: none
		sourceColumn: order_estimated_delivery_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Delivery Status' =
			
			IF (
			    ISBLANK ( Orders[order_delivered_customer_date] ),
			    BLANK(),
			    IF (
			        Orders[order_delivered_customer_date]
			            > Orders[order_estimated_delivery_date],
			        "Delayed",
			        "On Time"
			    )
			)
		lineageTag: ccddea85-e4cf-4a6b-a3ac-430ebca207bd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Purchase Date' = DATEVALUE(Orders[order_purchase_timestamp])
		formatString: dd-mm-yyyy
		lineageTag: 4c5d7844-b79b-49bb-82a0-b9521c67c485
